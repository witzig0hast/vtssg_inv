# Nicht-geheime Konfiguration für den Docker-Stack. Geheimnisse liegen in ./secrets (siehe scripts/init.sh).
APP_NAME="VTSSG Inventar"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://localhost
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=de

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=vtssg_inv02_db
DB_PORT=5432
DB_DATABASE=vtssg_inv
DB_USERNAME=vtssg_inv

# Sessions in der DB (Sperrung eines Benutzers beendet dessen Sitzungen sofort), Cache/Queue in Redis
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=vtssg_inv02_redis
REDIS_PORT=6379

# Nur Caddy darf PHP-FPM erreichen (internes Netz) → Proxy-Headern vertrauen
TRUSTED_PROXIES=*

# E-Mail (SMTP). Für lokale Tests: --profile dev und MAIL_HOST=vtssg_inv02_mailpit, MAIL_PORT=1025
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=inventar@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Sicherheit
INV_REQUIRE_2FA=true
INV_MAX_LOGIN_ATTEMPTS=5
INV_LOCKOUT_MINUTES=15
INV_PASSWORD_MIN=12

# Erstinstallation
ADMIN_EMAIL=admin@example.com

# ── Von docker compose gelesen (nicht vom Container) ──
# Domain für das TLS-Zertifikat. localhost = Caddy-interne CA, öffentliche Domain = Let's Encrypt.
APP_DOMAIN=localhost
# Im lokalen Netz mit eigenem Hostnamen: CADDY_TLS="tls internal"
CADDY_TLS=
# Optional, z. B. "email admin@firma.de" für Let's-Encrypt-Benachrichtigungen
CADDY_GLOBAL=
# 127.0.0.1 = nur lokal; 0.0.0.0 = im ganzen Netz erreichbar
BIND_IP=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=02
