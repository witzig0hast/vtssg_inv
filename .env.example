APP_NAME="VTSSG Inventar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Lokal: SQLite. Docker/Produktion: pgsql (siehe .env.docker.example)
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

MAIL_MAILER=log
MAIL_FROM_ADDRESS=inventar@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Sicherheit
INV_REQUIRE_2FA=false
INV_MAX_LOGIN_ATTEMPTS=5
INV_LOCKOUT_MINUTES=15
INV_PASSWORD_MIN=12
# Nur setzen, wenn ein vertrauenswürdiger Reverse-Proxy davor steht (Docker: siehe .env.docker.example)
TRUSTED_PROXIES=

# Initialer Administrator (nur beim ersten db:seed). Ohne ADMIN_PASSWORD wird ein Zufallspasswort ausgegeben.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
